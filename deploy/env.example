# /srv/blueport/.env — read by systemd at runtime (chmod 600, owner deploy). Not needed at build time.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Blueport Studio <kontakt@blueport.studio>
RESEND_FROM=
# Where contact-form notifications go
NOTIFICATION_EMAIL=
# Optional: overrides NOTIFICATION_EMAIL when set
# OWNER_EMAIL=
