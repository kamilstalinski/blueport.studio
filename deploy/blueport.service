# /etc/systemd/system/blueport.service
[Unit]
Description=Blueport Studio (Next.js standalone)
After=network.target

[Service]
User=deploy
# `current` is a symlink to the active release; systemd resolves it on every (re)start.
WorkingDirectory=/srv/blueport/current
EnvironmentFile=/srv/blueport/.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
